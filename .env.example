# Copy to .env. Everything is SENTINEL_-prefixed so a shared shell cannot
# feed the stack someone else's DATABASE_URL.

# -- database ----------------------------------------------------------------
# Host is the compose service name; use localhost for a local `uv run`.
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel

# -- storage -----------------------------------------------------------------
# Absolute, and the same in every container: the default is CWD-relative, so
# each service would otherwise write to its own copy.
SENTINEL_MEDIA_ROOT=/data/media
SENTINEL_ADAPTER_DIR=/app/docker/adapters
SENTINEL_COORDINATE_FILE=/app/db/seed/camera_coordinates.json

# -- the Sentinel sandbox ----------------------------------------------------
# The catalogue is the contract, the URL pattern is not; nothing here builds a
# stream endpoint. GET {base}/api/ingest 301s to a sign-in page without a
# session, so one of the two credentials below is required for the sync.
SENTINEL_SENTINEL_BASE_URL=
SENTINEL_SENTINEL_COOKIE=
SENTINEL_SENTINEL_TOKEN=

# -- crops -------------------------------------------------------------------
# Context around the detector box. The two-wheeler value is the one that
# matters: a COCO motorcycle box stops below the rider's head.
SENTINEL_CROP_PAD_FRAC=0.12
SENTINEL_CROP_PAD_TOP_TWO_WHEELER_FRAC=0.70

# -- logging -----------------------------------------------------------------
SENTINEL_LOG_JSON=true
SENTINEL_LOG_LEVEL=INFO

# Runs correlation inside the API process. The evaluation asks for three
# process groups; this is how you get there.
# SENTINEL_EMBED_CORRELATION=1
