# Copy to .env. Everything is SENTINEL_-prefixed so a shared shell cannot
# feed the stack someone else's DATABASE_URL.

# -- database ----------------------------------------------------------------
# Host is the compose service name; use localhost for a local `uv run`.
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel@postgres:5432/sentinel

# -- storage -----------------------------------------------------------------
# Absolute, and the same in every container: the default is CWD-relative, so
# each service would otherwise write to its own copy.
SENTINEL_MEDIA_ROOT=/data/media
SENTINEL_ADAPTER_DIR=/app/docker/adapters
SENTINEL_COORDINATE_FILE=/app/db/seed/camera_coordinates.json

# -- the Sentinel sandbox ----------------------------------------------------
# The catalogue is the contract, the URL pattern is not. GET
# {base}/cameras.json 302s to /auth/login without a session, so one of the two
# credentials below is required for the sync. (/api/ingest is tried as a
# fallback for estates that have not renamed the endpoint yet.)
SENTINEL_SENTINEL_BASE_URL=https://cctv.corp8.cloud
SENTINEL_SENTINEL_COOKIE=
SENTINEL_SENTINEL_TOKEN=

# -- grid media plane --------------------------------------------------------
# HLS is served through the CDN host above and works anywhere. RTSP and WebRTC
# cannot be proxied by a CDN, so they come off the gateway's own address and
# authenticate every connection with the registered email and access password
# embedded in the URL. Put them here unencoded -- the '@' is percent-encoded
# for you, and the credentialed URL is built at open() time so it never
# reaches a log line, the adapters table or an API response.
SENTINEL_GRID_EMAIL=
SENTINEL_GRID_PASSWORD=
SENTINEL_GRID_MEDIA_HOST=103.250.160.189
SENTINEL_GRID_RTSP_PORT=8554
SENTINEL_GRID_WHEP_PORT=8889

# Decode HLS off the CDN instead of RTSP off the gateway. Set this only where
# 8554/TCP is blocked: it costs latency and a segment of buffering.
# SENTINEL_GRID_PREFER_HLS=1

# -- crops -------------------------------------------------------------------
# Context around the detector box. The two-wheeler value is the one that
# matters: a COCO motorcycle box stops below the rider's head.
SENTINEL_CROP_PAD_FRAC=0.12
SENTINEL_CROP_PAD_TOP_TWO_WHEELER_FRAC=0.70

# -- logging -----------------------------------------------------------------
SENTINEL_LOG_JSON=true
SENTINEL_LOG_LEVEL=INFO

# Runs correlation inside the API process. The evaluation asks for three
# process groups; this is how you get there.
# SENTINEL_EMBED_CORRELATION=1
